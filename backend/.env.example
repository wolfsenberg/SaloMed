# Runtime is explicit:
# - demo: durable simulated ledger and in-app history; no Stellar transaction.
# - stellar_testnet: no real money, but signed testnet contract calls and RPC event history.
# - pdax_uat/pdax_prod: external settlement remains blocked until the private spec is verified.
# Start with demo; never use PDAX credentials or silently fall back to demo from another mode.
SALOMED_MODE=demo
SALOMED_ASSET_CODE=USDC
SALOMED_DB_PATH=./data/salomed.sqlite3
PHP_PER_USDC=56.00

# Stellar/Soroban testnet. Native XLM is only for network fees; vault value is USDC.
CONTRACT_ID=CAO3K6OYB5A3VNVV3HKCSVG3ZZ442DZCDKAXG4CTSLBTN7FOYCCBRZ34
STELLAR_NETWORK=testnet
SALOMED_CONTRACT_CONFIG_VERIFIED=false
SALOMED_EXPECTED_TOKEN_ID=
STELLAR_SOURCE=salomed-admin
ADMIN_ADDRESS=
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Never expose administrative mutation routes without a real secret.
SALOMED_ADMIN_API_KEY=

# PDAX is blocked unless SALOMED_MODE=pdax_uat/pdax_prod and the private
# institutional specification has been checked against these exact endpoints.
PDAX_BASE_URL=https://uat.services.sandbox.pdax.ph/api/pdax-api
PDAX_USERNAME=
PDAX_PASSWORD=
PDAX_WEBHOOK_SECRET=
PDAX_PRIVATE_SPEC_VERIFIED=false
PDAX_PRODUCTION_APPROVED=false

# Comma-separated browser origins are supported.
FRONTEND_ORIGIN=http://localhost:3000
